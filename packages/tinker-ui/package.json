{
  "name": "@tinker/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm build:js && pnpm build:types && pnpm build:css",
    "build:js": "node scripts/build-js.js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:css": "postcss src/styles/index.css -o dist/styles.css",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tinker/eslint": "workspace:*",
    "@tinker/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
